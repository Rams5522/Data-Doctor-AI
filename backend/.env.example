# LLM configuration
# Supported providers: ollama, openai, groq
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     

# Database
DATABASE_URL=sqlite:///./datadoctor_ai.db

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# Upload limits
MAX_UPLOAD_MB=25